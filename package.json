{
  "name": "cornman-strategic-hq",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "deploy": "vite build --config config/vite.config.ts && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --config config/.eslintrc.cjs",
    "format": "prettier --write . --config config/.prettierrc.cjs",
    "type-check": "tsc --noEmit -p config/tsconfig.json",
    "test": "vitest --config config/vitest.config.ts",
    "test:e2e": "cypress run",
    "test:coverage": "vitest run --coverage --config config/vitest.config.ts",
    "wa:server": "node scripts/wa-bot.mjs"
  },
  "dependencies": {
    "@adiwajshing/baileys": "^5.0.0",
    "@google-cloud/access-context-manager": "^4.2.0",
    "@google/genai": "^1.13.0",
    "@hapi/boom": "^10.0.1",
    "@supabase/supabase-js": "^2.56.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/twilio": "^3.19.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.19.2",
    "firebase": "^12.1.0",
    "lucide-react": "^0.462.0",
    "pino": "^8.21.0",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.1",
    "tailwind-merge": "^3.3.1",
    "twilio": "^5.8.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.17.1",
    "@types/pino": "^7.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "cypress": "^13.11.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.2",
    "process": "^0.11.10",
    "querystring-es3": "^0.2.1",
    "stream-browserify": "^3.0.0",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.8.2",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^1.6.0"
  }
}
